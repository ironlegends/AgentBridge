{
  "$schema": "https://schema.tauri.app/config/2",
  "identifier": "default",
  "description": "Default capability for the Agent Bridge desktop control panel",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-hide",
    "core:window:allow-show",
    "core:window:allow-minimize",
    "core:window:allow-set-focus",
    "dialog:allow-open",
    "opener:allow-open-path",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        {
          "url": "https://*"
        },
        {
          "url": "http://127.0.0.1/*"
        },
        {
          "url": "http://127.0.0.1:[0-9]/*"
        },
        {
          "url": "http://127.0.0.1:[0-9][0-9]/*"
        },
        {
          "url": "http://127.0.0.1:[0-9][0-9][0-9]/*"
        },
        {
          "url": "http://127.0.0.1:[0-9][0-9][0-9][0-9]/*"
        },
        {
          "url": "http://127.0.0.1:[0-9][0-9][0-9][0-9][0-9]/*"
        },
        {
          "url": "http://[[]::1]/*"
        },
        {
          "url": "http://[[]::1]:[0-9]/*"
        },
        {
          "url": "http://[[]::1]:[0-9][0-9]/*"
        },
        {
          "url": "http://[[]::1]:[0-9][0-9][0-9]/*"
        },
        {
          "url": "http://[[]::1]:[0-9][0-9][0-9][0-9]/*"
        },
        {
          "url": "http://[[]::1]:[0-9][0-9][0-9][0-9][0-9]/*"
        }
      ]
    },
    "allow-get-panel-state",
    "allow-save-panel-settings",
    "allow-set-permission-profile",
    "allow-initialize-local-state",
    "allow-start-or-restart-gateway",
    "allow-stop-gateway",
    "allow-get-missions-snapshot",
    "allow-get-mission-handoff",
    "allow-get-oauth-pending",
    "allow-enable-oauth-enrollment",
    "allow-approve-oauth-request",
    "allow-decide-extension-request",
    "allow-test-extension-connection",
    "allow-reload-extensions",
    "allow-get-skills-overview",
    "allow-run-skill-action",
    "allow-get-diagnostics",
    "allow-get-sessions",
    "allow-get-session-history",
    "allow-quit-app"
  ]
}
