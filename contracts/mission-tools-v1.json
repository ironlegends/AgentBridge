[
  {
    "name": "agent_bridge_status",
    "description": "Read isolated Agent Bridge gateway status.",
    "inputSchema": {
      "type": "object",
      "additionalProperties": false,
      "properties": {}
    }
  },
  {
    "name": "agent_bridge_context_create",
    "description": "Create an Agent Bridge actor context on the explicitly configured local development Core.",
    "inputSchema": {
      "type": "object",
      "additionalProperties": false,
      "properties": {}
    }
  },
  {
    "name": "agent_bridge_mission_create",
    "description": "Create one durable Agent Bridge mission. Supply a stable idempotency_key for safe retry.",
    "inputSchema": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "actor_context_handle": {
          "type": "string"
        },
        "goal": {
          "type": "string",
          "minLength": 1,
          "maxLength": 16384
        },
        "idempotency_key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      },
      "required": [
        "actor_context_handle",
        "goal",
        "idempotency_key"
      ]
    }
  },
  {
    "name": "agent_bridge_mission_get",
    "description": "Read a durable mission by existing context handle.",
    "inputSchema": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "actor_context_handle": {
          "type": "string"
        },
        "mission_id": {
          "type": "string"
        }
      },
      "required": [
        "actor_context_handle",
        "mission_id"
      ]
    }
  },
  {
    "name": "agent_bridge_mission_observe",
    "description": "Read the current owner context ID, your role and invitation state, and the mission revision. Available to invitees and attached members.",
    "inputSchema": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "actor_context_handle": {
          "type": "string"
        },
        "mission_id": {
          "type": "string"
        }
      },
      "required": [
        "actor_context_handle",
        "mission_id"
      ]
    }
  },
  {
    "name": "agent_bridge_mission_grant",
    "description": "As current owner, invite a distinct context at the observed revision. If the reply is uncertain, the invitee can observe their state.",
    "inputSchema": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "actor_context_handle": {
          "type": "string"
        },
        "mission_id": {
          "type": "string"
        },
        "if_revision": {
          "type": "integer",
          "minimum": 1
        },
        "target_context_id": {
          "type": "string",
          "description": "Public context ID of the recipient."
        }
      },
      "required": [
        "actor_context_handle",
        "mission_id",
        "if_revision",
        "target_context_id"
      ]
    }
  },
  {
    "name": "agent_bridge_mission_attach",
    "description": "Accept your invitation using its observed revision. Observe your state before any retry after an uncertain reply.",
    "inputSchema": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "actor_context_handle": {
          "type": "string"
        },
        "mission_id": {
          "type": "string"
        },
        "if_revision": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "actor_context_handle",
        "mission_id",
        "if_revision"
      ]
    }
  },
  {
    "name": "agent_bridge_mission_transfer",
    "description": "As current owner, transfer ownership to a distinct attached member at the observed revision. Observe the current owner after an uncertain reply.",
    "inputSchema": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "actor_context_handle": {
          "type": "string"
        },
        "mission_id": {
          "type": "string"
        },
        "if_revision": {
          "type": "integer",
          "minimum": 1
        },
        "target_context_id": {
          "type": "string",
          "description": "Public context ID of the recipient."
        }
      },
      "required": [
        "actor_context_handle",
        "mission_id",
        "if_revision",
        "target_context_id"
      ]
    }
  },
  {
    "name": "agent_bridge_mission_list",
    "description": "List at most 100 durable missions visible to this context.",
    "inputSchema": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "actor_context_handle": {
          "type": "string"
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        }
      },
      "required": [
        "actor_context_handle"
      ]
    }
  },
  {
    "name": "agent_bridge_mission_checkpoints",
    "description": "Read bounded durable result checkpoints without replay.",
    "inputSchema": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "actor_context_handle": {
          "type": "string"
        },
        "mission_id": {
          "type": "string"
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        }
      },
      "required": [
        "actor_context_handle",
        "mission_id"
      ]
    }
  },
  {
    "name": "agent_bridge_mission_handoff",
    "description": "Read a compact, redacted mission handoff as an attached member. No transfer, replay or mission mutation.",
    "inputSchema": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "actor_context_handle": {
          "type": "string",
          "pattern": "^ctx_[0-9a-f]{32}$"
        },
        "mission_id": {
          "type": "string",
          "pattern": "^mis_[0-9a-f]{32}$"
        }
      },
      "required": [
        "actor_context_handle",
        "mission_id"
      ]
    }
  },
  {
    "name": "agent_bridge_mission_checkpoint",
    "description": "Persist a result summary at observed revision. Read before any retry after an uncertain reply.",
    "inputSchema": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "actor_context_handle": {
          "type": "string"
        },
        "mission_id": {
          "type": "string"
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "if_revision": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "actor_context_handle",
        "mission_id",
        "summary",
        "if_revision"
      ]
    }
  },
  {
    "name": "agent_bridge_mission_subtask_create",
    "description": "As current mission owner, create a durable web-agent subtask. Optionally assign it to an attached context. Use a stable idempotency key.",
    "inputSchema": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "actor_context_handle": {
          "type": "string"
        },
        "mission_id": {
          "type": "string"
        },
        "goal": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "assignee_context_id": {
          "type": "string",
          "description": "Public context ID of an attached mission member."
        },
        "idempotency_key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      },
      "required": [
        "actor_context_handle",
        "mission_id",
        "goal",
        "idempotency_key"
      ]
    }
  },
  {
    "name": "agent_bridge_mission_subtask_assign",
    "description": "As current mission owner, assign pending or blocked work to an attached context using the subtask revision and a stable idempotency key.",
    "inputSchema": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "actor_context_handle": {
          "type": "string"
        },
        "mission_id": {
          "type": "string"
        },
        "subtask_id": {
          "type": "string",
          "pattern": "^sub_[0-9a-f]{32}$"
        },
        "idempotency_key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "if_revision": {
          "type": "integer",
          "minimum": 1,
          "description": "Current subtask revision."
        },
        "assignee_context_id": {
          "type": "string",
          "description": "Public context ID of an attached mission member."
        }
      },
      "required": [
        "actor_context_handle",
        "mission_id",
        "subtask_id",
        "if_revision",
        "idempotency_key",
        "assignee_context_id"
      ]
    }
  },
  {
    "name": "agent_bridge_mission_subtask_list",
    "description": "As an attached member, read current subtask assignments and results in creation order. Read after an uncertain reply before taking further action.",
    "inputSchema": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "actor_context_handle": {
          "type": "string"
        },
        "mission_id": {
          "type": "string"
        },
        "subtask_id": {
          "type": "string",
          "pattern": "^sub_[0-9a-f]{32}$"
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20
        },
        "after_created_revision": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "actor_context_handle",
        "mission_id"
      ]
    }
  },
  {
    "name": "agent_bridge_mission_subtask_update",
    "description": "As the assigned context, record in_progress before starting, or record blocked or completed with a summary. A replayed acknowledgement is for reconciliation only.",
    "inputSchema": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "actor_context_handle": {
          "type": "string"
        },
        "mission_id": {
          "type": "string"
        },
        "subtask_id": {
          "type": "string",
          "pattern": "^sub_[0-9a-f]{32}$"
        },
        "idempotency_key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "if_revision": {
          "type": "integer",
          "minimum": 1,
          "description": "Current subtask revision."
        },
        "status": {
          "type": "string",
          "enum": [
            "in_progress",
            "blocked",
            "completed"
          ]
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        }
      },
      "required": [
        "actor_context_handle",
        "mission_id",
        "subtask_id",
        "if_revision",
        "idempotency_key",
        "status"
      ]
    }
  },
  {
    "name": "agent_bridge_mission_complete",
    "description": "Complete a mission using its observed revision and stable idempotency key.",
    "inputSchema": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "actor_context_handle": {
          "type": "string"
        },
        "mission_id": {
          "type": "string"
        },
        "if_revision": {
          "type": "integer",
          "minimum": 1
        },
        "idempotency_key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      },
      "required": [
        "actor_context_handle",
        "mission_id",
        "if_revision",
        "idempotency_key"
      ]
    }
  }
]
