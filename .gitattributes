# Preserve upstream legal notice bytes and their reviewed SHA-256 pins.
licenses/rust-fallbacks/** -text
# WINAPP-BUILD-PROVENANCE.json pins this script with the CRLF bytes it was
# built from. Unconverted, every checkout and the source archive match it.
scripts/rust/build-winapp-passive.py -text whitespace=cr-at-eol
# Tauri regenerates these files with LF, including on Windows.
app/src-tauri/permissions/autogenerated/*.toml text eol=lf
# The original upstream legal texts include significant verbatim line endings/spaces.
licenses/rust-fallbacks/selectors-0.38.0/LICENSE-MPL-2.0 whitespace=-blank-at-eol
licenses/rust-fallbacks/webview2-com-sys-0.39.1/WEBVIEW2-SDK-LICENSE.txt whitespace=-blank-at-eol
